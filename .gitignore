node_modules/
dist/
.vite/
*.log
.DS_Store
*.tsbuildinfo
.env
.env.local
.env.*.local
playwright-report/
test-results/
.playwright/

# Data pipeline raw sources (large, regenerable) — committed outputs only
/pipelines/swift/.build/
/pipelines/swift/sources/
/pipelines/*.cache/

# FAA distributions a pipeline run downloads and unpacks in place. CI
# fetches these fresh every run; a local run leaves them behind.
/pipelines/swift/nasr-distribution/
/pipelines/swift/*.zip
/pipelines/swift/*.[Dd][Aa][Tt]
/pipelines/swift/FAACIFP18

# Dependencies are pinned by revision SHA in Package.swift, so a resolved
# file adds nothing and would only churn the CI cache key.
/pipelines/swift/Package.resolved

# Aircraft POH PDFs are large; only the extracted performance.yaml is
# committed. Keep the source PDF locally if you want, but don't commit it.
/aircraft/**/*.pdf
